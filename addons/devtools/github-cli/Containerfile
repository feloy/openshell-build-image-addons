# The upstream gh binary is statically linked and works with either libc.
# docker.io/library/alpine:3.24.2
FROM docker.io/library/alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS builder
ARG GH_VERSION=""

ENV HOME=/tmp
USER root
RUN apk add --no-cache bash ca-certificates curl

USER 65532
COPY addons/devtools/github-cli/install.sh /tmp/install-github-cli.sh
RUN bash /tmp/install-github-cli.sh

FROM scratch
COPY --from=builder /tmp/rootfs/ /
ENV PATH=/usr/local/bin
