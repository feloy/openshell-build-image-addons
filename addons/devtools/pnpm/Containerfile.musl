# docker.io/library/alpine:3.24.2
FROM docker.io/library/alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS builder
ARG PNPM_VERSION=""
ARG PNPM_SHA256=""
ARG PNPM_LICENSE_SHA256=""

USER root
RUN apk add --no-cache bash ca-certificates curl

USER 65532
COPY addons/devtools/pnpm/install.sh /tmp/install-pnpm.sh
RUN bash /tmp/install-pnpm.sh musl

FROM scratch
COPY --from=builder /tmp/rootfs/ /
ENV PATH=/usr/local/bin

ARG PNPM_VERSION
LABEL org.opencontainers.image.title="pnpm" \
      org.opencontainers.image.description="pnpm package manager native binary, with a pnpx launcher." \
      org.opencontainers.image.version="${PNPM_VERSION:-12.21.0}" \
      ai.openkaiden.addon.name="pnpm" \
      ai.openkaiden.addon.category="devtools"
