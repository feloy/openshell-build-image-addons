# docker.io/library/node:24.22.3-bookworm-slim
FROM docker.io/library/node@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS builder

USER root
RUN apt-get update && apt-get install -y --no-install-recommends patchelf && rm -rf /var/lib/apt/lists/*

USER 65532
COPY addons/runtimes/node-24/install.sh /tmp/install-node.sh
RUN sh /tmp/install-node.sh

# Prefer the base's runtime libraries, with private fallbacks for minimal bases.
# Scope this search path to Node so other executables keep their own libraries.
RUN cp -L /usr/lib/*-linux-gnu/libstdc++.so.6 \
          /usr/lib/*-linux-gnu/libgcc_s.so.1 /tmp/rootfs/usr/local/lib/node-24/ && \
    patchelf --set-rpath "/lib64:/usr/lib64:/lib/$(uname -m)-linux-gnu:/usr/lib/$(uname -m)-linux-gnu:/lib:/usr/lib:\$ORIGIN/../lib/node-24" \
        /tmp/rootfs/usr/local/bin/node

FROM scratch
COPY --from=builder /tmp/rootfs/ /
ADD --chmod=0644 --checksum=sha256:5888dbb9a1d2b18f2c3e6c5f6af1b39de658372b402a0577b002777f14c62ace \
    https://raw.githubusercontent.com/nodejs/node/v24.22.3/LICENSE /usr/local/share/licenses/node/LICENSE
ENV PATH=/usr/local/bin

LABEL org.opencontainers.image.title="Node.js 24" \
      org.opencontainers.image.description="Node.js 24 runtime with npm, npx, Corepack and headers for native modules." \
      org.opencontainers.image.version="24.22.3" \
      ai.openkaiden.addon.name="node-24" \
      ai.openkaiden.addon.category="runtimes"
