# registry.access.redhat.com/hi/core-runtime:latest-builder
FROM registry.access.redhat.com/hi/core-runtime@sha256:9e64e6716489071ad17be6f3b58f2cb3ac47763e1e4cf9cde01b1f44497bd82a AS builder
ARG CODEX_VERSION=""
ARG CODEX_ACP_VERSION=""
ARG CODEX_ACP_SHA=""

USER root
RUN dnf install -y gawk git gzip tar unzip && dnf clean all
COPY scripts/install-bun.sh /tmp/install-bun.sh
RUN bash /tmp/install-bun.sh

USER 65532
COPY addons/agents/codex/install.sh /tmp/install-agent.sh
RUN bash /tmp/install-agent.sh

COPY scripts/build-acp.sh /tmp/build-acp.sh
ENV ACP_OUTPUT="codex-acp"
RUN HOME=/tmp ACP_VERSION="${CODEX_ACP_VERSION}" ACP_SHA="${CODEX_ACP_SHA}" \
    bash /tmp/build-acp.sh

# Now create our final image with reduced layers.
FROM scratch
COPY --from=builder /tmp/rootfs/ /
# Notify the ACP adapter where the Codex binary is located.
ENV CODEX_PATH=/usr/local/bin/codex
ENV PATH=/usr/local/bin

ARG CODEX_VERSION
LABEL org.opencontainers.image.title="Codex" \
      org.opencontainers.image.description="OpenAI Codex CLI with the Codex ACP adapter." \
      org.opencontainers.image.version="${CODEX_VERSION:-0.159.3}" \
      ai.openkaiden.openshell-build-image.name="codex" \
      ai.openkaiden.openshell-build-image.category="agents"
