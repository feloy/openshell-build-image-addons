ARG CLAUDE_CODE_VERSION=2.1.286
ARG BUN_VERSION="bun-v1.4.2"
ARG CLAUDE_AGENT_ACP_VERSION=v0.85.0
ARG CLAUDE_AGENT_ACP_SHA=c84845272fe3c55c1f97759f00ee48a1356fccae

# registry.access.redhat.com/hi/core-runtime:latest-builder
FROM registry.access.redhat.com/hi/core-runtime@sha256:9e64e6716489071ad17be6f3b58f2cb3ac47763e1e4cf9cde01b1f44497bd82a AS glibc-builder
ARG CLAUDE_CODE_VERSION
ARG BUN_VERSION
ARG CLAUDE_AGENT_ACP_VERSION
ARG CLAUDE_AGENT_ACP_SHA

USER root
RUN dnf install -y git unzip && dnf clean all
RUN set -eux; \
    curl -fsSL https://bun.com/install | bash -s -- "${BUN_VERSION}"; \
    install -D -m 0755 "$(readlink -f /tmp/.bun/bin/bun)" /usr/local/bin/bun

USER 65532
RUN mkdir -p /tmp/rootfs

# Install Claude and copy it into the glibc filesystem.
RUN set -eux; \
    curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_CODE_VERSION}"; \
    install -D -m 0755 "$(readlink -f /tmp/.local/bin/claude)" /tmp/rootfs/usr/local/bin/claude

# Build the ACP wrapper with bun and copy it into the glibc filesystem.
RUN set -eux; \
    git clone --depth 1 --branch "${CLAUDE_AGENT_ACP_VERSION}" https://github.com/agentclientprotocol/claude-agent-acp /tmp/claude-agent-acp; \
    test "$(git -C /tmp/claude-agent-acp rev-parse HEAD)" = "${CLAUDE_AGENT_ACP_SHA}"; \
    cd /tmp/claude-agent-acp; \
    bun install; \
    bun build --compile src/index.ts --outfile /tmp/rootfs/usr/local/bin/claude-agent-acp

# docker.io/library/alpine:3.24.2
FROM docker.io/library/alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS musl-builder
ARG CLAUDE_CODE_VERSION
ARG BUN_VERSION
ARG CLAUDE_AGENT_ACP_VERSION
ARG CLAUDE_AGENT_ACP_SHA

ENV HOME=/tmp
USER root
RUN apk add --no-cache bash ca-certificates curl git libgcc libstdc++ ripgrep unzip
RUN set -eux; \
    curl -fsSL https://bun.com/install | bash -s -- "${BUN_VERSION}"; \
    install -D -m 0755 "$(readlink -f /tmp/.bun/bin/bun)" /usr/local/bin/bun
RUN chown -R 65532:65532 /tmp/.bun

USER 65532
RUN mkdir -p /tmp/rootfs

# Install Claude and copy it into the musl filesystem.
RUN set -eux; \
    curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_CODE_VERSION}"; \
    install -D -m 0755 "$(readlink -f /tmp/.local/bin/claude)" /tmp/rootfs/usr/local/bin/claude

# Build the ACP wrapper with bun and copy it into the musl filesystem.
RUN set -eux; \
    git clone --depth 1 --branch "${CLAUDE_AGENT_ACP_VERSION}" https://github.com/agentclientprotocol/claude-agent-acp /tmp/claude-agent-acp; \
    test "$(git -C /tmp/claude-agent-acp rev-parse HEAD)" = "${CLAUDE_AGENT_ACP_SHA}"; \
    cd /tmp/claude-agent-acp; \
    bun install; \
    bun build --compile src/index.ts --outfile /tmp/rootfs/usr/local/bin/claude-agent-acp

FROM scratch
COPY --from=glibc-builder /tmp/rootfs/ /glibc/
COPY --from=musl-builder /tmp/rootfs/ /musl/
LABEL ai.openkaiden.openshell-build-image.libc.glibc="/glibc" \
      ai.openkaiden.openshell-build-image.libc.musl="/musl"
# These values apply after a variant's files are copied into the base image.
ENV CLAUDE_CODE_EXECUTABLE=/usr/local/bin/claude
ENV PATH=/usr/local/bin
