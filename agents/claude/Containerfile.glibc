# registry.access.redhat.com/hi/core-runtime:latest-builder
FROM registry.access.redhat.com/hi/core-runtime@sha256:9e64e6716489071ad17be6f3b58f2cb3ac47763e1e4cf9cde01b1f44497bd82a AS builder
ARG CLAUDE_CODE_VERSION=""
ARG BUN_VERSION=""
ARG CLAUDE_AGENT_ACP_VERSION=""
ARG CLAUDE_AGENT_ACP_SHA=""

USER root
RUN dnf install -y git unzip && dnf clean all
COPY scripts/install-bun.sh /tmp/install-bun.sh
RUN bash /tmp/install-bun.sh

USER 65532
COPY scripts/build-acp.sh /tmp/build-acp.sh
COPY agents/claude/install.sh /tmp/install-agent.sh
RUN bash /tmp/install-agent.sh

# Now create our final image with reduced layers
FROM scratch
COPY --from=builder /tmp/rootfs/ /
# Notify the SDK/ACP client where claude binary is located
ENV CLAUDE_CODE_EXECUTABLE=/usr/local/bin/claude
ENV PATH=/usr/local/bin
