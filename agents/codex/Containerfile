# CODEX_VERSION must stay in the range accepted by @openai/codex in the ACP adapter.
ARG CODEX_VERSION=0.159.3
ARG BUN_VERSION="bun-v1.4.2"
ARG CODEX_ACP_VERSION=v2.1.1
ARG CODEX_ACP_SHA=68d7d2d5ddfc0ed5746f9f6130892dda685e65dd

# registry.access.redhat.com/hi/core-runtime:latest-builder
FROM registry.access.redhat.com/hi/core-runtime@sha256:9e64e6716489071ad17be6f3b58f2cb3ac47763e1e4cf9cde01b1f44497bd82a AS glibc-builder
ARG CODEX_VERSION
ARG BUN_VERSION
ARG CODEX_ACP_VERSION
ARG CODEX_ACP_SHA

USER root
RUN dnf install -y gawk git gzip tar unzip && dnf clean all
RUN set -eux; \
    curl -fsSL https://bun.com/install | bash -s -- "${BUN_VERSION}"; \
    install -D -m 0755 "$(readlink -f /tmp/.bun/bin/bun)" /usr/local/bin/bun

USER 65532
RUN mkdir -p /tmp/rootfs/usr/local/bin /tmp/rootfs/usr/local/lib

# Keep the whole standalone package: Codex needs its metadata and bundled tools.
RUN set -eux; \
    curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh -s -- --release "${CODEX_VERSION}"; \
    cp -a "$(readlink -f /tmp/.codex/packages/standalone/current)" /tmp/rootfs/usr/local/lib/codex; \
    ln -s ../lib/codex/bin/codex /tmp/rootfs/usr/local/bin/codex

# Build the ACP adapter with bun and copy it into the glibc filesystem.
RUN set -eux; \
    git clone --depth 1 --branch "${CODEX_ACP_VERSION}" https://github.com/agentclientprotocol/codex-acp /tmp/codex-acp; \
    test "$(git -C /tmp/codex-acp rev-parse HEAD)" = "${CODEX_ACP_SHA}"; \
    cd /tmp/codex-acp; \
    bun install; \
    bun build --compile src/index.ts --outfile /tmp/rootfs/usr/local/bin/codex-acp

# docker.io/library/alpine:3.24.2
FROM docker.io/library/alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS musl-builder
ARG CODEX_VERSION
ARG BUN_VERSION
ARG CODEX_ACP_VERSION
ARG CODEX_ACP_SHA

ENV HOME=/tmp
USER root
RUN apk add --no-cache bash ca-certificates curl git libgcc libstdc++ ripgrep unzip
RUN set -eux; \
    curl -fsSL https://bun.com/install | bash -s -- "${BUN_VERSION}"; \
    install -D -m 0755 "$(readlink -f /tmp/.bun/bin/bun)" /usr/local/bin/bun
RUN chown -R 65532:65532 /tmp/.bun

USER 65532
RUN mkdir -p /tmp/rootfs/usr/local/bin /tmp/rootfs/usr/local/lib

# Keep the whole standalone package: Codex needs its metadata and bundled tools.
# Upstream ARM64 musl packages currently bundle glibc-linked rg, which cannot run on Alpine.
# Track the packaging fix: https://github.com/openai/codex/issues/52578
RUN set -eux; \
    curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh -s -- --release "${CODEX_VERSION}"; \
    cp -a "$(readlink -f /tmp/.codex/packages/standalone/current)" /tmp/rootfs/usr/local/lib/codex; \
    ln -s ../lib/codex/bin/codex /tmp/rootfs/usr/local/bin/codex

# Build the ACP adapter with bun and copy it into the musl filesystem.
RUN set -eux; \
    git clone --depth 1 --branch "${CODEX_ACP_VERSION}" https://github.com/agentclientprotocol/codex-acp /tmp/codex-acp; \
    test "$(git -C /tmp/codex-acp rev-parse HEAD)" = "${CODEX_ACP_SHA}"; \
    cd /tmp/codex-acp; \
    bun install; \
    bun build --compile src/index.ts --outfile /tmp/rootfs/usr/local/bin/codex-acp

# Copy the runtime libraries needed by the compiled ACP adapter.
RUN set -eux; \
    cp -P /usr/lib/libstdc++.so.* /usr/lib/libgcc_s.so.* /tmp/rootfs/usr/local/lib/

FROM scratch
COPY --from=glibc-builder /tmp/rootfs/ /glibc/
COPY --from=musl-builder /tmp/rootfs/ /musl/
LABEL ai.openkaiden.openshell-build-image.libc.glibc="/glibc" \
      ai.openkaiden.openshell-build-image.libc.musl="/musl"
# These values apply after a variant's files are copied into the base image.
ENV CODEX_PATH=/usr/local/bin/codex
ENV PATH=/usr/local/bin
