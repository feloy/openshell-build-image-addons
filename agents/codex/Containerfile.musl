# docker.io/library/alpine:3.24.2
FROM docker.io/library/alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS builder
ARG CODEX_VERSION=""
ARG BUN_VERSION=""
ARG CODEX_ACP_VERSION=""
ARG CODEX_ACP_SHA=""

ENV HOME=/tmp
USER root
RUN apk add --no-cache bash ca-certificates curl git libgcc libstdc++ ripgrep unzip
COPY scripts/install-bun.sh /tmp/install-bun.sh
RUN bash /tmp/install-bun.sh
RUN chown -R 65532:65532 /tmp/.bun

USER 65532
# Upstream ARM64 musl packages currently bundle glibc-linked rg, which cannot run on Alpine.
# Track the packaging fix: https://github.com/openai/codex/issues/52578
COPY scripts/build-acp.sh /tmp/build-acp.sh
COPY agents/codex/install.sh /tmp/install-agent.sh
RUN bash /tmp/install-agent.sh

# Copy the runtime libraries needed by the compiled ACP adapter.
RUN set -eux; \
    cp -P /usr/lib/libstdc++.so.* /usr/lib/libgcc_s.so.* /tmp/rootfs/usr/local/lib/

# Now create our final image with reduced layers.
FROM scratch
COPY --from=builder /tmp/rootfs/ /
# Notify the ACP adapter where the Codex binary is located.
ENV CODEX_PATH=/usr/local/bin/codex
ENV PATH=/usr/local/bin
